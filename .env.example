# Server-only Starknet mainnet RPC. Replace the placeholder in .env.local.
# Never prefix this value with NEXT_PUBLIC because it contains the Alchemy key.
STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Exact browser origin and HMAC secret for signed sessions. Never commit the real secret.
VEILAP_APP_ORIGIN=http://127.0.0.1:3003
VEILAP_SESSION_SECRET=replace-with-at-least-64-random-characters

# Persisted mode requires all values below. Preview mode may leave them unset.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
VEILAP_WALLET_HASH_PEPPER=replace-with-at-least-64-random-characters
VEILAP_KMS_KEY_ID=arn:aws:kms:eu-west-1:000000000000:key/replace-me
AWS_REGION=eu-west-1
VEILAP_RECEIPT_SIGNING_PRIVATE_KEY=replace-with-a-secret-signing-key
VEILAP_RECEIPT_SIGNING_PUBLIC_KEY=replace-with-a-public-signing-key

# Public chain metadata contains no secret.
NEXT_PUBLIC_STARKNET_CHAIN_ID=SN_MAIN
NEXT_PUBLIC_STRK20_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# Preview remains on until the wallet-backed mainnet flow is ready.
NEXT_PUBLIC_VEILAP_PREVIEW_MODE=1
# Local-only opt-in: allows an in-memory wallet session for the synthetic preview.
# Never set this in a persisted/production deployment.
VEILAP_PREVIEW_AUTH=1
