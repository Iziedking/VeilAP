# Server-only Starknet mainnet RPC. Replace the placeholder in .env.local.
# Never prefix this value with NEXT_PUBLIC because it contains the Alchemy key.
STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Exact browser origin and HMAC secret for signed sessions. Never commit the real secret.
VEILAP_APP_ORIGIN=http://127.0.0.1:3000
VEILAP_SESSION_SECRET=replace-with-at-least-32-random-characters

# Task 4 uses a process-local nonce store only in development. Production wallet
# authentication intentionally refuses until Task 5 installs the durable Postgres store.

# Public chain metadata contains no secret.
NEXT_PUBLIC_STARKNET_CHAIN_ID=SN_MAIN
NEXT_PUBLIC_STRK20_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# Preview remains on until the wallet-backed mainnet flow is ready.
NEXT_PUBLIC_VEILAP_PREVIEW_MODE=1
